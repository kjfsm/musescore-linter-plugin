{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"deny": [
			"Read(./.env)",
			"Edit(./.env)",
			"Read(./.env.local)",
			"Edit(./.env.local)",
			"Read(./.env.production)",
			"Edit(./.env.production)",

			"Read(./**/dist/**)",
			"Edit(./**/dist/**)",
			"Read(./dist-cli/**)",
			"Edit(./dist-cli/**)",
			"Read(./.turbo/**)",
			"Edit(./.turbo/**)",
			"Read(./coverage/**)",
			"Edit(./coverage/**)",

			"Edit(./pnpm-lock.yaml)",
			"Edit(./package-lock.json)",
			"Edit(./yarn.lock)",
			"Edit(./**/node_modules/**)"
		]
	}
}
