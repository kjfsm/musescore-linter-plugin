{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".oxlintrc.json",
    ".oxfmtrc.json",
    ".editorconfig",
    "tsconfig.json",
    "vitest.config.ts",
    "pnpm-lock.yaml"
  ],
  // どの層がどの層に依存してよいかはここだけに書く。許可は推移的に効くので、下の層が依存するものも並べる。
  "boundaries": {
    "tags": {
      "model": { "dependencies": { "allow": [] } },
      "reader-musicxml": { "dependencies": { "allow": ["model"] } },
      "musescore-api": { "dependencies": { "allow": ["musescore-api"] } },
      "reader-musescore": { "dependencies": { "allow": ["model", "musescore-api"] } },
      "rules": { "dependencies": { "allow": ["model"] } },
      "lint-app": { "dependencies": { "allow": ["model", "rules"] } }
    }
  },
  "tasks": {
    "typecheck": {
      "description": "TypeScript の型チェック。依存パッケージの typecheck が先に完了している必要がある。",
      "dependsOn": ["^typecheck"]
    },
    // ルートのタスクの既定の入力はルート直下のファイルだけで、パッケージの変更を見落とす。
    // リポジトリ全体を見る検査はキャッシュしない。
    "//#lint": { "cache": false },
    "//#knip": { "cache": false },
    "//#docs:check": { "cache": false },
    "test:e2e": {
      "description": "apps/web を wrangler dev で _headers の CSP ごと配り、外への通信と CSP 違反が無いことを確かめる。ビルドは webServer が行う。",
      "dependsOn": ["^typecheck"],
      "cache": false
    },
    "//#test": {
      "description": "vitest で全パッケージのテストを 1 回で実行し、カバレッジの閾値も見る（スクリプトはルートだけが持つ）。全体で 1 秒未満なので、パッケージ単位に分ける利点がない。",
      "dependsOn": ["^typecheck"],
      "inputs": [
        "packages/*/src/**",
        "packages/*/tests/**",
        "apps/*/src/**",
        "apps/*/tests/**",
        "tools/*/src/**",
        "tools/*/tests/**",
        "fixtures/**"
      ],
      "outputs": []
    },
    "build": {
      "description": "apps/* の成果物を作る。plugin は QML 向けバンドル、cli は単一ファイルの CLI、web は Vite。",
      "dependsOn": ["^typecheck", "typecheck", "//#test"],
      "inputs": ["$TURBO_DEFAULT$", "!dist/**"],
      "outputs": ["dist/**"]
    },
    "package": {
      "description": "apps/plugin の dist/ を配布用 ZIP にする。",
      "dependsOn": ["build"],
      // README はリポジトリのルートから同梱する
      "inputs": ["dist/**", "package.json", "scripts/package.ts", "$TURBO_ROOT$/README.md"],
      // 版無しの 2 本は release.yml と、2.4.0 以前のプラグインの更新リンクが参照する。
      // ここに無いとキャッシュヒット時に復元されず古いものが残る。
      "outputs": ["score-linter-*.zip", "score-linter.zip", "musescore-linter-plugin.zip"]
    }
  }
}
