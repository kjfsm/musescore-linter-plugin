{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".oxlintrc.json",
    ".oxfmtrc.json",
    ".editorconfig",
    "tsconfig.json",
    "vitest.config.ts",
    "pnpm-lock.yaml"
  ],
  "tasks": {
    "build": {
      "description": "apps/* のフロントエンドを Vite でビルドする。ルートタスクの //#build（QML バンドル）とは別物。",
      "dependsOn": ["^typecheck", "//#test"],
      "inputs": ["$TURBO_DEFAULT$", "!dist/**"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "description": "TypeScript の型チェックを実行する。依存パッケージの typecheck が先に完了している必要がある。",
      "dependsOn": ["^typecheck"]
    },
    "//#test": {
      "description": "vitest で全パッケージのユニットテストを 1 回で実行する。パッケージ単位に分けていた頃は、alias だけが違う vitest.config.ts が 5 本並んでいた。全体で 1 秒未満なので分割する利点がない。",
      "dependsOn": [
        "@musescore-linter/core#typecheck",
        "@musescore-linter/checkers#typecheck",
        "@musescore-linter/cli#typecheck",
        "@musescore-linter/source-musescore#typecheck",
        "@musescore-linter/source-musicxml#typecheck",
        "@musescore-linter/web#typecheck"
      ],
      "inputs": ["packages/*/src/**", "packages/*/tests/**", "apps/*/src/**", "apps/*/tests/**"],
      "outputs": []
    },
    "//#typecheck:root": {
      "description": "ルート直下の src/（QML 向けバンドル入口）と scripts/ を型チェックする。パッケージ側の typecheck とは対象が重ならない。",
      "dependsOn": [
        "@musescore-linter/core#typecheck",
        "@musescore-linter/checkers#typecheck",
        "@musescore-linter/source-musescore#typecheck"
      ],
      "inputs": ["src/**", "scripts/**", "tsconfig.json"]
    },
    "//#build": {
      "description": "esbuild でプラグインをバンドルし dist/ へ出力する。core・checkers パッケージのテスト通過後に実行される。",
      "dependsOn": ["@musescore-linter/musescore-api#typecheck", "//#test"],
      "inputs": [
        "src/**",
        "scripts/build.ts",
        "packages/core/src/**",
        "packages/checkers/src/**",
        "packages/source-musescore/src/**",
        // scripts/build.ts が dist/ へコピー・テンプレート置換する対象。
        // ここに無いと QML だけ編集したときキャッシュ誤ヒットで dist が古いままになる。
        "ScoreLinter.qml",
        "qml/**",
        // __PLUGIN_VERSION__ の注入元
        "package.json"
      ],
      "outputs": ["dist/**"]
    },
    "//#build:cli": {
      "description": "esbuild で musescore-lint CLI を dist-cli/ へ単一ファイルにバンドルする。QML 向けの //#build とは独立。",
      "dependsOn": ["//#test"],
      "inputs": [
        "scripts/build-cli.ts",
        "packages/cli/**",
        "packages/core/src/**",
        "packages/checkers/src/**",
        "packages/source-musicxml/src/**"
      ],
      "outputs": ["dist-cli/**"]
    },
    "//#package": {
      "description": "dist/ の成果物を配布用 ZIP にパッケージングする。",
      "dependsOn": ["//#build"],
      "inputs": ["dist/**", "README.md", "package.json", "scripts/package.ts"],
      // scripts/package.ts は版付きと版無しの 2 本を書き出す。版無し
      // （musescore-linter-plugin.zip）は release.yml が参照するので、
      // ここに無いとキャッシュヒット時に復元されず古いものが残る。
      "outputs": ["musescore-linter-plugin-*.zip", "musescore-linter-plugin.zip"]
    }
  }
}
