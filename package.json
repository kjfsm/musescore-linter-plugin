{
  "name": "score-linter",
  "private": true,
  "type": "module",
  "scripts": {
    "bench": "pnpm --filter @score-linter/bench bench",
    "boundaries": "turbo boundaries",
    "build:cli": "pnpm --filter @score-linter/cli build",
    "build:plugin": "pnpm --filter @score-linter/plugin build",
    "build:web": "pnpm --filter @score-linter/web build",
    "changeset": "changeset",
    "deploy:web": "pnpm --filter @score-linter/web deploy",
    "dev": "vitest",
    "dev:web": "pnpm --filter @score-linter/web dev",
    "docs:check": "pnpm --filter @score-linter/rule-docs check",
    "docs:rules": "pnpm --filter @score-linter/rule-docs generate",
    "generate:types": "pnpm --filter @score-linter/musescore-api-types-generator generate",
    "knip": "knip",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt",
    "lint:score": "node apps/cli/src/main.ts",
    "package": "pnpm --filter @score-linter/plugin package",
    "prepare": "simple-git-hooks",
    "preview:web": "pnpm --filter @score-linter/web preview",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "verify": "turbo boundaries && turbo run lint knip docs:check typecheck test build package test:e2e",
    "version": "changeset version"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "catalog:",
    "knip": "^6.42.1",
    "oxfmt": "0.74.0",
    "oxlint": "^1.89.0",
    "simple-git-hooks": "^2.14.0",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "vitest": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "simple-git-hooks"
    ]
  }
}
