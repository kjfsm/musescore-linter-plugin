{
  "name": "score-linter",
  "private": true,
  "scripts": {
    "build:plugin": "pnpm --filter @score-linter/plugin build",
    "build:cli": "pnpm --filter @score-linter/cli build",
    "build:web": "pnpm --filter @score-linter/web build",
    "bench": "pnpm --filter @score-linter/bench bench",
    "dev:web": "pnpm --filter @score-linter/web dev",
    "preview:web": "pnpm --filter @score-linter/web preview",
    "deploy:web": "pnpm --filter @score-linter/web deploy",
    "lint:score": "tsx apps/cli/src/main.ts",
    "package": "pnpm --filter @score-linter/plugin package",
    "pipeline": "turbo run typecheck test build package",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "dev": "vitest",
    "knip": "knip",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt",
    "changeset": "changeset",
    "version": "changeset version",
    "prepare": "simple-git-hooks",
    "generate:types": "pnpm --filter @score-linter/musescore-api-types-generator generate",
    "boundaries": "turbo boundaries"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^25.8.0",
    "@vitest/coverage-v8": "catalog:",
    "knip": "^6.41.0",
    "oxfmt": "0.73.0",
    "oxlint": "^1.88.0",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.9",
    "typescript": "^6.0.3",
    "vitest": "catalog:",
    "wrangler": "^4.151.1"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "simple-git-hooks"
    ]
  }
}
