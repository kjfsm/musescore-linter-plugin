{
  "name": "musescore-linter-plugin",
  "version": "2.4.0",
  "private": true,
  "scripts": {
    "build:plugin": "tsx scripts/build.ts",
    "build:cli": "tsx scripts/build-cli.ts",
    "build:web": "pnpm --filter @musescore-linter/web build",
    "bench": "tsx scripts/bench.ts",
    "dev:web": "pnpm --filter @musescore-linter/web dev",
    "preview:web": "pnpm --filter @musescore-linter/web preview",
    "deploy:web": "pnpm --filter @musescore-linter/web deploy",
    "lint:score": "tsx packages/cli/src/main.ts",
    "package": "tsx scripts/package.ts",
    "pipeline": "turbo run typecheck test build build:plugin build:cli package",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "dev": "vitest",
    "knip": "knip",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt",
    "changeset": "changeset",
    "version": "changeset version",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@musescore-linter/checkers": "workspace:*",
    "@musescore-linter/core": "workspace:*",
    "@musescore-linter/source-musescore": "workspace:*",
    "@musescore-linter/source-musicxml": "workspace:*",
    "@types/node": "^25.8.0",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.1",
    "fflate": "^0.8.3",
    "knip": "^6.30.0",
    "oxfmt": "0.61.0",
    "oxlint": "^1.76.0",
    "simple-git-hooks": "^2.13.1",
    "tsx": "^4.23.1",
    "turbo": "^2.10.7",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "simple-git-hooks"
    ]
  }
}
