{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // ルートの types: ["node"] を打ち消す。ブラウザ向けコードに process /
    // Buffer / node:fs を書けなくするための検知装置なので消さないこと。
    // （tests/ は node:fs を使うので tsconfig.node.json 側で見る）
    "types": [],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"]
}
