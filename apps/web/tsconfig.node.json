{
  // vite.config.ts と tests/ 向け。こちらは node:path / node:fs を使うので
  // types: ["node"] を継承したまま使う。
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["vite.config.ts", "tests/**/*"]
}
