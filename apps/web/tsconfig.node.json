{
  // vite.config.ts と tests/ 向け。こちらは node:path / node:fs を使うので
  // types: ["node"] を継承したまま使う。
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "@/*": ["./src/*"],
      "@score-linter/core": ["../../packages/core/src/index.ts"],
      "@score-linter/checkers": ["../../packages/checkers/src/index.ts"],
      "@score-linter/source-musicxml": ["../../packages/source-musicxml/src/index.ts"],
      "@score-linter/cli": ["../cli/src/index.ts"]
    }
  },
  "include": ["vite.config.ts", "tests/**/*"]
}
