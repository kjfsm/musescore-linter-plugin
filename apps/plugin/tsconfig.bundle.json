{
  // QML 向けバンドル（scripts/build.ts、target es2017）に入るプラグイン自身のコードを ES2017 の標準ライブラリで
  // 型検査する。バンドルに入るパッケージは、それぞれの tsconfig.json が同じ制約で検査する。
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["ES2017"],
    "types": []
  },
  "include": ["src/bundle-entry.ts", "src/qml-globals.d.ts"]
}
