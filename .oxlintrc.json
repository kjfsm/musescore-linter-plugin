{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["unicorn", "typescript", "oxc", "react", "jsx-a11y"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    // `.sort()` を `.toSorted()` に置き換えろというルール。`toSorted` は ES2023 で、
    // QML 向けバンドル（scripts/build.ts）は target es2017。--fix が走ると
    // MuseScore 上で動かないコードになるため無効化する。
    "unicorn/no-array-sort": "off",
    // `__dirname`（Node 組み込み）・`__CLI_VERSION__`（esbuild define）は意図的な命名。
    "eslint/no-underscore-dangle": "off",
    // テストヘルパを describe 内に置くのは意図的なスコープ分け。
    "unicorn/consistent-function-scoping": "off",
    // React 19 + automatic JSX runtime（tsconfig の "jsx": "react-jsx"）を使っており
    // `import React` は書かない方針。このルールは classic runtime 前提で誤検知するため無効化する。
    "react/react-in-jsx-scope": "off",
    // react-hooks の本体ルール。oxlint では pedantic カテゴリ扱いで
    // correctness/suspicious のみを有効にしている本設定ではデフォルト無効になるため、
    // Hooks のルール違反を確実に検出できるよう明示的に有効化する。
    "react/rules-of-hooks": "error"
  },
  "ignorePatterns": [
    "**/dist/**",
    "coverage/**",
    "out/**",
    // tools/musescore-api-types-generator の生成物。手で直さず生成元を直す
    "packages/musescore-api-types/src/generated/**"
  ],
  "overrides": [
    {
      // 境界の本体は package.json の依存宣言で、ここは宣言を書き足されたときの保険。
      "files": ["packages/score-model/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@score-linter/*"],
                "message": "score-model は他のパッケージに依存しない。"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/reader-musicxml/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@score-linter/*", "!@score-linter/score-model"],
                "message": "reader-musicxml は score-model だけに依存する。"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/reader-musescore/src/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@score-linter/*",
                  "!@score-linter/score-model",
                  "!@score-linter/musescore-api-types",
                  "!@score-linter/musescore-plugin-helpers"
                ],
                "message": "reader-musescore は score-model と MuseScore の型・ヘルパだけに依存する。"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/linter/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@score-linter/*", "!@score-linter/score-model"],
                "message": "linter は score-model だけに依存する。"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/lint-app/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@score-linter/*", "!@score-linter/score-model", "!@score-linter/linter"],
                "message": "lint-app は linter と score-model だけに依存する。"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@score-linter/linter",
                "importNames": ["createLinter", "isRuleEnabled"],
                "message": "ホストは lint-app の createLintApp を通して lint する。"
              }
            ],
            // 目的はホストが lint-app を迂回して lint を組み立てるのを防ぐこと。reader・score-model は
            // ホストが入口から呼ぶ層なので、深い import を禁じる理由が無い
            "patterns": [
              {
                "group": ["@score-linter/linter/src/**", "@score-linter/lint-app/src/**"],
                "message": "linter と lint-app は入口（index.ts）が公開するものだけを使う。"
              }
            ]
          }
        ]
      }
    }
  ]
}
