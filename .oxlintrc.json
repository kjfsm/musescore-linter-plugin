{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["unicorn", "typescript", "oxc", "react", "jsx-a11y"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    // `.sort()` を `.toSorted()` に置き換えろというルール。`toSorted` は ES2023 で、
    // QML 向けバンドル（scripts/build.ts）は target es2017。--fix が走ると
    // MuseScore 上で動かないコードになるため無効化する。
    "unicorn/no-array-sort": "off",
    // `__dirname`（Node 組み込み）・`__CLI_VERSION__`（esbuild define）・
    // `_eventsCount`（LintIR の内部キャッシュ判定）はいずれも意図的な命名。
    "eslint/no-underscore-dangle": "off",
    // テストヘルパを describe 内に置くのは意図的なスコープ分け。
    "unicorn/consistent-function-scoping": "off",
    // React 19 + automatic JSX runtime（tsconfig の "jsx": "react-jsx"）を使っており
    // `import React` は書かない方針。このルールは classic runtime 前提で誤検知するため無効化する。
    "react/react-in-jsx-scope": "off",
    // react-hooks の本体ルール。oxlint では pedantic カテゴリ扱いで
    // correctness/suspicious のみを有効にしている本設定ではデフォルト無効になるため、
    // Hooks のルール違反を確実に検出できるよう明示的に有効化する。
    "react/rules-of-hooks": "error"
  },
  "ignorePatterns": ["dist/**", "dist-cli/**", "coverage/**", "out/**"],
  "overrides": [
    {
      // core と checkers は MuseScore に依存しない、が CLAUDE.md の最重要制約。
      // これまで package.json の記述と人の注意力だけで守られていたので、
      // import を機械的に塞いでおく。MuseScore を触ってよいのは
      // source-musescore と musescore-api だけ。
      "files": ["packages/core/**", "packages/checkers/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@kjfsm/musescore-plugin-sdk-*", "@musescore-linter/musescore-api"],
                "message": "core / checkers は MuseScore に依存しない。入力ソース側（source-musescore）の責務。"
              }
            ]
          }
        ]
      }
    }
  ]
}
