{
  "name": "@kjfsm/musescore-plugin-sdk-types",
  "version": "2.1.0",
  "description": "TypeScript type definitions for the MuseScore 4 Plugin API.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./globals": {
      "types": "./dist/globals.d.ts",
      "import": "./dist/globals.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kjfsm/musescore-plugin-sdk",
    "directory": "packages/types"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "publint": "publint",
    "attw": "attw --pack --profile esm-only",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
