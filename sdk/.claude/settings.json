{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": ["Bash(pnpm *)", "Bash(turbo *)", "Bash(node *)", "Bash(vitest *)"],
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Read(./.env.local)",
      "Edit(./.env.local)",
      "Read(./.env.production)",
      "Edit(./.env.production)",

      "Read(./**/dist/**)",
      "Edit(./**/dist/**)",
      "Read(./.turbo/**)",
      "Edit(./.turbo/**)",
      "Read(./.cache/**)",
      "Edit(./.cache/**)",

      "Edit(./packages/types/src/generated/**)",
      "Edit(./pnpm-lock.yaml)",
      "Edit(./package-lock.json)",
      "Edit(./yarn.lock)",
      "Edit(./**/node_modules/**)"
    ]
  }
}
